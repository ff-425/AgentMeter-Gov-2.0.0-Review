AGENTMETER_ENV=production
AGENTMETER_HOST=0.0.0.0
AGENTMETER_PORT=8765
AGENTMETER_REQUIRE_AUTH=true
AGENTMETER_API_TOKEN=replace-with-a-long-random-token
AGENTMETER_AUDIT_SIGNING_KEY=replace-with-a-separate-signing-key
AGENTMETER_DATABASE_URL=sqlite:////app/data/agentmeter.db
AGENTMETER_FLOW_LOGS=/app/data/openclaw_guard_flow_events.jsonl
AGENTMETER_MAX_LOG_BYTES=10485760
AGENTMETER_LOG_BACKUPS=5
AGENTMETER_SKILL_SIGNING_KEY=replace-with-skill-verification-key
POSTGRES_PASSWORD=replace-with-a-database-password
